<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <IsPackable>true</IsPackable>
    <Description>Agentic layer for TensorSharp: Agent Skills (SKILL.md bundles, progressive disclosure, script execution) and code execution — a sandboxed shell tool plus a deterministic apply_patch editor, in the style of Codex and Claude Code — with OS sandboxing, per-session workspaces and dependency installation. Built on TensorSharp.Runtime.</Description>
    <PackageTags>$(TensorSharpPackageTags);agent;skills;code-execution;shell;apply-patch;sandbox;tools</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InferenceWeb.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- One direction only: the agentic layer builds ON the runtime. The runtime
         must never reference back, or the split stops meaning anything — a host
         that wants plain OpenAI/Ollama serving can then take TensorSharp.Runtime
         alone and carry none of this. -->
    <ProjectReference Include="..\TensorSharp.Runtime\TensorSharp.Runtime.csproj" />
    <ProjectReference Include="..\TensorSharp.Knowledge\TensorSharp.Knowledge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
  </ItemGroup>
</Project>
