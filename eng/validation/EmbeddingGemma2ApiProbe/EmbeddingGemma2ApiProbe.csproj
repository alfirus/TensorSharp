<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TensorSharpApiProbeSnapshot)' == ''">
    <ProjectReference Include="../../../TensorSharp.Models/TensorSharp.Models.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TensorSharpApiProbeSnapshot)' != ''">
    <Reference Include="$(TensorSharpApiProbeSnapshot)/*.dll"
               Exclude="$(TensorSharpApiProbeSnapshot)/EmbeddingGemma2Probe.dll;$(TensorSharpApiProbeSnapshot)/TensorSharp.Server.Host.dll" />
  </ItemGroup>
  <Target Name="RequireFrozenApiProbe" BeforeTargets="ResolveReferences" Condition="'$(TensorSharpApiProbeSnapshot)' != ''">
    <Error Condition="!Exists('$(TensorSharpApiProbeSnapshot)/TensorSharp.Models.dll')"
           Text="TensorSharpApiProbeSnapshot must name the qualified frozen runtime directory." />
  </Target>
</Project>
