<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TensorSharpSchedulingProbeSnapshot" Value="$(TensorSharpSchedulingProbeSnapshot)" />
    <Reference Include="$(TensorSharpSchedulingProbeSnapshot)/*.dll"
               Exclude="$(TensorSharpSchedulingProbeSnapshot)/TensorSharp.Server.Host.dll;$(TensorSharpSchedulingProbeSnapshot)/GgmlOps.dll" />
    <Content Include="$(TensorSharpSchedulingProbeSnapshot)/runtimes/**/*"
             Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(TensorSharpSchedulingProbeSnapshot)/*.so;$(TensorSharpSchedulingProbeSnapshot)/*.so.*;$(TensorSharpSchedulingProbeSnapshot)/*.dylib"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../EmbeddingGemma2CompositeInputProbe/DefaultHttpSource.cs" Link="DefaultHttpSource.cs" />
  </ItemGroup>
  <Target Name="RequireFrozenSchedulingProbe" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TensorSharpSchedulingProbeSnapshot)' == '' Or !Exists('$(TensorSharpSchedulingProbeSnapshot)/TensorSharp.Models.dll') Or !Exists('$(TensorSharpSchedulingProbeSnapshot)/TensorSharp.Runtime.dll')"
           Text="Set TensorSharpSchedulingProbeSnapshot to an immutable inference directory; no production dependencies are rebuilt." />
  </Target>
</Project>
