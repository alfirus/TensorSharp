<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../../TensorSharp.Models/TensorSharp.Models.csproj" /></ItemGroup>
  <Target Name="CopyVisionSpatialLibraries" AfterTargets="Build">
    <ItemGroup>
      <VisionSpatialLibrary Include="../../../TensorSharp.Backends.MLX/bin/*.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <VisionSpatialLibrary Include="../../../TensorSharp.Backends.MLX/bin/*.metallib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    </ItemGroup>
    <Copy SourceFiles="@(VisionSpatialLibrary)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
