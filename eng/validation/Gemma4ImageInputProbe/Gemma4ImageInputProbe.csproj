<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Observe the actual published processor in a frozen inference snapshot.
         No model/backend project is built or referenced as source. -->
    <Reference Include="$(TensorSharpImageProbeSnapshot)/*.dll"
               Exclude="$(TensorSharpImageProbeSnapshot)/TensorSharp.Server.Host.dll" />
  </ItemGroup>
  <Target Name="RequireFrozenImageProbe" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TensorSharpImageProbeSnapshot)' == '' Or !Exists('$(TensorSharpImageProbeSnapshot)/TensorSharp.Models.dll')"
           Text="Set TensorSharpImageProbeSnapshot to a frozen inference directory containing TensorSharp.Models.dll." />
  </Target>
</Project>
