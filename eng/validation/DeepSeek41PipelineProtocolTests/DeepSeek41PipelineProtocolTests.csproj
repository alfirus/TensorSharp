<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Match the model assembly's existing InternalsVisibleTo grant. This
         focused runner avoids server/UI dependencies for pure transport tests. -->
    <AssemblyName>InferenceWeb.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <Compile Include="../../../InferenceWeb.Tests/DeepSeek41PipelineProtocolTests.cs" Link="DeepSeek41PipelineProtocolTests.cs" />
    <Compile Include="../../../InferenceWeb.Tests/DeepSeek41PipelineOverlapTests.cs" Link="DeepSeek41PipelineOverlapTests.cs" />
    <Compile Include="../../../InferenceWeb.Tests/DeepSeek41PipelineGreedyTests.cs" Link="DeepSeek41PipelineGreedyTests.cs" />
    <ProjectReference Include="../../../TensorSharp.Models/TensorSharp.Models.csproj" />
  </ItemGroup>
</Project>
