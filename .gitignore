## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
TensorSharp.GGML.Native/build/
TensorSharp.GGML.Native/build-windows/
TensorSharp.GGML.Native/build-ios/

# mlx-c/mlx are fetched and built at build time by
# TensorSharp.Backends.MLX/build-native-macos.sh; neither the build tree nor the
# installed dylibs/metallib are committed.
TensorSharp.Backends.MLX/Native/build/
TensorSharp.Backends.MLX/Native/dist/

# ggml sources are cloned at build time from https://github.com/ggml-org/ggml
# (see eng/fetch-ggml.sh / eng/fetch-ggml.ps1), not committed.
ExternalProjects/.ggml-fetch.lock
ExternalProjects/.ggml-patches.lock
ExternalProjects/.ggml-fetch.lock.d/
ExternalProjects/ggml/

# Portable Vulkan build toolchain (headers, loader import lib, glslc), provisioned
# at build time by eng/fetch-vulkan-toolchain.ps1 when no Vulkan SDK is installed.
ExternalProjects/vulkan-toolchain/
# cuDNN redistributable provisioned by eng/fetch-cudnn (~1.1 GB, headers + DLLs).
ExternalProjects/cudnn/
# CPython for iOS (BeeWare Python-Apple-support), fetched by eng/fetch-python-ios.sh
ExternalProjects/python-ios/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# IDE/build caches
*.csproj.lscache

# Visual Studio IDE state
.vs/

# Visual Studio generates per-user debug profiles on F5; they are machine-local.
launchSettings.json

# Bytecode left behind by running a skill's or a tool's Python scripts. It must
# never reach the app bundle: a .pyc built by one CPython is dead weight to
# another, and the bundled interpreter compiles from source anyway.
__pycache__/

# Benchmark tooling artifacts
benchmarks/engine_comparison/results/
/.vs
/TensorSharp.Server/Properties/launchSettings.json

# Local model weights. GGUF/safetensors checkpoints are multi-GB and are
# downloaded per-machine, never committed.
/models/
*.gguf
*.safetensors
# ...except the tiny synthetic checkpoints that unit tests embed as fixtures.
!/InferenceWeb.Tests/Fixtures/Ltx25/*.safetensors

# JetBrains Rider / IntelliJ per-user project settings.
.idea/

# Local scratch prompts used when driving the CLI by hand.
prompt.txt

# Staged embedded-Python bundle layout produced by TensorAgent/scripts/prepare-python.sh
TensorAgent/python-runtime/

# Claude Code session state and agent worktrees
.claude/

# Generated validation evidence stays local; keep reusable tools and fixtures elsewhere.
/docs/validation/
